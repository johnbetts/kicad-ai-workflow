{"checks_run": ["fab_clearances", "fab_connector_access", "fab_grid_alignment", "fab_silkscreen", "fab_board_utilization"], "detail": "5 verdicts over 4 views", "input_sha256": "f5862dba6eb7047fb5e2667127b51971b397bdd69388614ad5ceba9fcb478cfe", "output_sha256": "2d:92c5d471b92a,3d_top:74f5bac4314a,3d_iso:a1063d3af25a,3d_iso_back:58ebbf06fa0a", "passed": false, "stage": "review_fab", "timestamp": "2026-06-11T18:46:03.075537+00:00", "violations": [{"constraint": "review_fab:fab_connector_access", "limit": 0.0, "measured": 1.0, "message": "J3 (2-pin header) is stranded in the middle-bottom of the board nowhere near an edge, and J2's pin column is inset from the right edge rather than on it; only J1 (RJ45) properly faces outward at the left edge.", "refs": ["J3", "J2"], "severity": "critical"}, {"constraint": "review_fab:fab_silkscreen", "limit": 0.0, "measured": 1.0, "message": "In the 2D view C1 and R3 designators overlap each other, the U1 label renders doubled/illegible, J2 and J3 labels sit directly on their pin-1 pads, and Y1/C4/C5 text overlaps component pads.", "refs": ["C1", "R3", "C2", "U1", "J2", "J3", "Y1", "C4", "C5"], "severity": "minor"}, {"constraint": "review_fab:fab_board_utilization", "limit": 0.0, "measured": 1.0, "message": "Roughly half the board (entire bottom region, top-left, and right of J2) is empty copper while all circuitry crowds a center-left band, and J3 is stranded alone mid-board far from any functional group.", "refs": ["J3", "U1", "J1"], "severity": "major"}]}
{"checks_run": ["ee_decoupling", "ee_signal_flow", "ee_crossing_attach_lines", "ee_isolation", "ee_rf_antenna", "ee_power_topology"], "detail": "6 verdicts over 4 views", "input_sha256": "f5862dba6eb7047fb5e2667127b51971b397bdd69388614ad5ceba9fcb478cfe", "output_sha256": "2d:92c5d471b92a,3d_top:74f5bac4314a,3d_iso:a1063d3af25a,3d_iso_back:58ebbf06fa0a", "passed": false, "stage": "review_ee", "timestamp": "2026-06-11T18:46:03.137553+00:00", "violations": [{"constraint": "review_ee:ee_decoupling", "limit": 0.0, "measured": 1.0, "message": "C1-C3 are stacked in a single column roughly 4-8mm left of U1 with an intervening pad row between them and the IC body, rather than each cap sitting immediately adjacent to the power pin it serves.", "refs": ["C1", "C2", "C3", "U1"], "severity": "major"}, {"constraint": "review_ee:ee_signal_flow", "limit": 0.0, "measured": 1.0, "message": "All six SPI/control ratsnest lines from the right-edge header J2 double back across the entire U1 footprint to pads on the IC's left side, so the SPI chain does not read in placement order.", "refs": ["J2", "U1"], "severity": "major"}, {"constraint": "review_ee:ee_crossing_attach_lines", "limit": 0.0, "measured": 1.0, "message": "Straight pad-to-pad lines from J1's RX-/RX+/TX pins visibly cross each other on the way to the termination passives, and the J2-to-U1 SPI bundle fans across the IC, forcing avoidable crossover traces.", "refs": ["J1", "J2", "U1"], "severity": "major"}]}
{"checks_run": ["bodies_no_overlap", "bodies_flat_on_board", "bodies_on_pads", "orientation_sane", "antenna_zone_clear", "groups_visually_coherent"], "detail": "6 verdicts over 4 views", "input_sha256": "f5862dba6eb7047fb5e2667127b51971b397bdd69388614ad5ceba9fcb478cfe", "output_sha256": "2d:92c5d471b92a,3d_top:74f5bac4314a,3d_iso:a1063d3af25a,3d_iso_back:58ebbf06fa0a", "passed": false, "stage": "gate_b", "timestamp": "2026-06-11T18:46:03.199757+00:00", "violations": [{"constraint": "vision:bodies_on_pads", "limit": 0.0, "measured": 1.0, "message": "3d_top shows two long vertical rows of bare pads flanking U1 with no component body on them, and the 2d view shows U1's body outline with these displaced pad strips rather than pads under the body, so the body/footprint correspondence is not clearly satisfied.", "refs": ["U1"], "severity": "critical"}, {"constraint": "vision:groups_visually_coherent", "limit": 0.0, "measured": 1.0, "message": "The 2d view shows J3 stranded alone mid-board far from any group, J2 isolated at the top-right with long ratsnest runs to U1, overlapping silkscreen in the C1/R3/C2 passive column, and large dead regions in all four corners while the center is congested.", "refs": ["J3", "J2", "C1", "R3", "C2"], "severity": "major"}]}
