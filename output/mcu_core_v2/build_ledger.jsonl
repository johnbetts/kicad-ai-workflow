{"checks_run": ["fab_clearances", "fab_connector_access", "fab_grid_alignment", "fab_silkscreen", "fab_board_utilization"], "detail": "5 verdicts over 4 views", "input_sha256": "06a9c368e5116529573fb7275717b5791cdb68b77fcb7a57224ca4faab7a300f", "output_sha256": "2d:cb3941727bf1,3d_top:effde2e1cae4,3d_iso:e01bc494b6e0,3d_iso_back:e611ea604318", "passed": false, "stage": "review_fab", "timestamp": "2026-06-11T18:46:02.885194+00:00", "violations": [{"constraint": "review_fab:fab_grid_alignment", "limit": 0.0, "measured": 1.0, "message": "The two repeated button subcircuits are not identical: SW2's passives (R3 offset higher and to the left) do not mirror SW1's arrangement, C2 floats alone between the groups, and R3/R1/R4/R2 do not form a single aligned row, giving a ragged scattered look in the 2D view.", "refs": ["R3", "R1", "R4", "R2", "C2", "SW1", "SW2"], "severity": "major"}, {"constraint": "review_fab:fab_silkscreen", "limit": 0.0, "measured": 1.0, "message": "C1 and C5 designators overlap each other directly, the U1 bottom pad row labels (15-26) collapse into one illegible garbled string of overlapping text, and R5/D1 labels nearly collide right of the module.", "refs": ["C1", "C5", "U1", "R5", "D1"], "severity": "minor"}, {"constraint": "review_fab:fab_board_utilization", "limit": 0.0, "measured": 1.0, "message": "Large dead regions occupy most of the right half (only J2), the left side, and both bottom corners while all circuitry crowds the center, and J2 is stranded a full board-width from U1 with long ratsnest lines crossing the empty area.", "refs": ["J2", "J1", "U1", "SW1", "SW2"], "severity": "major"}]}
{"checks_run": ["ee_decoupling", "ee_signal_flow", "ee_crossing_attach_lines", "ee_isolation", "ee_rf_antenna", "ee_power_topology"], "detail": "6 verdicts over 4 views", "input_sha256": "06a9c368e5116529573fb7275717b5791cdb68b77fcb7a57224ca4faab7a300f", "output_sha256": "2d:cb3941727bf1,3d_top:effde2e1cae4,3d_iso:e01bc494b6e0,3d_iso_back:e611ea604318", "passed": false, "stage": "review_ee", "timestamp": "2026-06-11T18:46:02.947618+00:00", "violations": [{"constraint": "review_ee:ee_decoupling", "limit": 0.0, "measured": 1.0, "message": "C1/C5 sit immediately adjacent to U1 pins 2 (3V3) and 3 (EN), but C2 (+3V3/GND pads) is stranded mid-board roughly 10mm below the module with resistors and switches between it and any IC power pin.", "refs": ["C2", "U1", "C1", "C5"], "severity": "major"}, {"constraint": "review_ee:ee_crossing_attach_lines", "limit": 0.0, "measured": 1.0, "message": "U1's right pin column places 37:TXD above 36:RXD while J2 orders UART_RX above UART_TX, so the straight TXD->UART_TX and RXD->UART_RX connections cross each other (visible crossing ratsnest lines), forcing an avoidable crossover.", "refs": ["U1", "J2"], "severity": "major"}, {"constraint": "review_ee:ee_rf_antenna", "limit": 0.0, "measured": 1.0, "message": "The antenna keepout above U1 is free of components, but it is recessed several millimetres from the top board edge so board material (and potential copper pour) extends beyond the antenna instead of the antenna sitting at the edge.", "refs": ["U1"], "severity": "critical"}]}
